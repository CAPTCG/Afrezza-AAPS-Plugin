diff --git a/ui/src/test/kotlin/app/aaps/ui/compose/afrezzaDialog/AfrezzaDoseMappingTest.kt b/ui/src/test/kotlin/app/aaps/ui/compose/afrezzaDialog/AfrezzaDoseMappingTest.kt
