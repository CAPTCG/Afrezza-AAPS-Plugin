diff --git a/core/objects/src/test/kotlin/app/aaps/core/objects/extensions/InsulinInhaledExtensionTest.kt b/core/objects/src/test/kotlin/app/aaps/core/objects/extensions/InsulinInhaledExtensionTest.kt
